# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---- First admin account (created automatically on first start) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Admin

# ---- Google sign-in (leave blank = button shows "not set up yet") ----
# Create at https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application
# Authorized JavaScript origin: http://localhost:5173   (full guide: GOOGLE_SETUP.md, or run setup-google.bat)
# Paste only the Client ID (ends with .apps.googleusercontent.com), NOT the client secret.
GOOGLE_CLIENT_ID=

# ---- Restrict who can sign up (optional) ----
# Comma-separated list. Leave blank to allow any email address.
# Example: ALLOWED_EMAIL_DOMAINS=myschool.edu.pk,gmail.com
ALLOWED_EMAIL_DOMAINS=

# ---- Email (leave SMTP_HOST blank: emails are printed in the server console instead) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Issue Reporter <no-reply@example.com>"

# ---- Behaviour ----
REQUIRE_EMAIL_VERIFICATION=false
MAX_UPLOAD_MB=5
